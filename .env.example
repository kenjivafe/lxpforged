# --- Shopify Storefront API (headless commerce) -----------------------------
# Cart, checkout, payments, tax and shipping stay on Shopify. This app only
# reads the catalogue and builds carts against it.

# Your myshopify domain, with or without the scheme. Use the myshopify domain
# rather than lxpforged.com — it stays valid if the custom domain changes.
SHOPIFY_STORE_DOMAIN=krtymq-v4.myshopify.com

# Public Storefront API access token, sent as X-Shopify-Storefront-Access-Token.
#
# OPTIONAL. Shopify serves public catalogue and cart operations to
# unauthenticated Storefront requests, so the app runs without this. Leave it
# EMPTY rather than wrong: an invalid token is rejected with a 401, where an
# absent one is not. A real token is still the right end state — it is the
# documented path, it is required for non-public data, and unauthenticated
# access is behaviour Shopify could tighten.
#
# Easiest route: Shopify admin -> Settings -> Apps and sales channels ->
# Develop apps -> Create an app -> Configure Storefront API scopes -> Install.
# The token is then under the app's "API credentials" tab.
#
# Alternative: add the Headless sales channel, which issues public and private
# tokens for you and is purpose-built for this setup.
#
# Scopes needed:
#   unauthenticated_read_product_listings   Product and Collection objects
#   unauthenticated_read_product_inventory  quantityAvailable / totalAvailable
#   unauthenticated_read_product_tags       the `tags` field the product
#                                           fragment selects
#   unauthenticated_read_checkouts          Cart object
#   unauthenticated_write_checkouts         Cart object
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional. Pin the Storefront API version; defaults to 2026-07.
# SHOPIFY_STOREFRONT_API_VERSION=2026-07

# Signing secret for the products/* and collections/* webhooks that point at
# /api/revalidate. Without it that route refuses to revalidate.
SHOPIFY_WEBHOOK_SECRET=
